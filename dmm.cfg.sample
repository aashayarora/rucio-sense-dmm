[dmm]
port=80
log_level=INFO
api_token=

[auth]
client_id=
client_secret=
redirect_uri=https://dmm.example.org/auth/callback
metadata_url=https://sense-o.es.net:8543/realms/StackV/.well-known/openid-configuration
session_hours=12
session_secret=

[db]
db_type=postgres
username=dmm
password=dmm
db_host=localhost
db_port=5432
db_name=dmm

[sense]
profile_uuid=
sense_keep_alive_seconds=60
keep_failed_instances=false
path_check_enabled=true
no_resources_backoff_seconds=120
no_resources_blocked_max_retries=3

[rtmon]
deployment=

[decider]
min_upward_modify_fraction=0.1
max_utilization=0.8
split=least_waste
schedule_horizon_hours=24

[prometheus]
host=
user=
password=

[fts]
fts_host=https://fts3-pilot.cern.ch:8446
cert=/opt/certs/cert.pem
key=/opt/certs/key.pem
default_num_streams=20
max_delete_retries=3

[rucio]
max_retries=1
heartbeat_timeout=30
activities=SENSE Test
rule_lookback_hours=24

[fts-streams]
T2_US_SDSC-T2_US_Caltech=400
T2_US_Caltech-T2_US_SDSC=400
T2_US_SDSC-T1_US_FNAL=200
T1_US_FNAL-T2_US_SDSC=200

[daemons]
rucio=10
dmm=10
sense=10
fts=10
monit=60
db=7200
rucio_heartbeat=60

[vlan-ranges]
T2_US_SDSC-T2_US_Caltech=3602-3606
T2_US_SDSC-T2_US_Caltech_Test=3602-3606

[site-aliases]
